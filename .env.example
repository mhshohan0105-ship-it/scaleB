# Copy this file to .env and fill in your own values. .env is git ignored.
# FTP account: cPanel > FTP Accounts (or your main cPanel login).
FTP_HOST=ftp.scalebbd.com
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
# Folder on the server, relative to the FTP login's home directory.
FTP_REMOTE_DIR=public_html
# true = encrypted FTPS. Only set false if the host does not support it.
FTP_SECURE=true
